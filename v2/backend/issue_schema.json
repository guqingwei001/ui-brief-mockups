{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI 设计简报 · 公开期次文件（ui-brief-v2-proposal）",
  "description": "网页与飞书共同消费的唯一数据源。只含可公开字段；正文全文、评分、证据、审核日志、投递状态都留在内部文件。",
  "type": "object",
  "required": ["schema_version", "issue_id", "issue_date", "status", "title", "intro", "articles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "ui-brief-v2-proposal"},
    "issue_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "issue_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "期次日期，不等于文章日期"},
    "status": {"enum": ["demo", "published"], "description": "draft 不进入公开目录"},
    "version": {"type": "integer", "minimum": 1, "description": "同一 issue_id 的发布版本号；重发飞书不递增"},
    "title": {"type": "string", "minLength": 1},
    "intro": {"type": "string", "minLength": 1},
    "note": {"type": "string"},
    "articles": {
      "type": "array",
      "description": "数组顺序即展示顺序；允许为空（空期）",
      "items": {
        "type": "object",
        "required": ["id", "title", "takeaway", "summary", "key_points", "constraints", "impact", "advice", "tags", "source", "analysis_status", "review_status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "takeaway": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "key_points": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "impact": {"type": ["string", "null"]},
          "advice": {"type": ["string", "null"]},
          "tags": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source": {
            "type": "object",
            "required": ["name", "url", "original_title", "date", "date_kind"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "url": {"type": "string", "pattern": "^https?://"},
              "original_title": {"type": "string", "minLength": 1},
              "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "date_kind": {"enum": ["published", "updated", "unknown"]}
            }
          },
          "analysis_status": {"enum": ["ready", "needs_review", "insufficient_source"]},
          "review_status": {"enum": ["not_reviewed", "reviewed"]},
          "migration_note": {"type": "string"}
        }
      }
    }
  }
}
